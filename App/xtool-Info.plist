<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- xtool build only: the INFOPLIST_KEY_* settings of project.yml, which xtool does not read. -->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Nova Drive</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Nova Drive listens to your voice commands.</string>
	<key>NSCameraUsageDescription</key>
	<string>Nova Drive 需要用摄像头回答你关于画面的问题。</string>
	<key>NSContactsUsageDescription</key>
	<string>Nova Drive 需要读取通讯录，才能按名字帮你打电话。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>小诺在手机上把你说的普通话转成文字，用来显示字幕和识别“别说了”等指令，录音不会上传。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Nova Drive 用你的位置搜索附近的地点、规划路线和查询当地天气。</string>
</dict>
</plist>
